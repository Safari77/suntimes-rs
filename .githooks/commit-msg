#!/usr/bin/env python3

# git config core.hooksPath .githooks

import argparse
import hashlib
import os
import re
import subprocess
import sys
import tempfile
import tomllib
from dataclasses import dataclass
from pathlib import Path


class ConfigError(Exception):
    pass


@dataclass(frozen=True)
class ValidatorConfig:
    require_scope: bool
    allowed_scopes: list[str] | None
    allowed_scopes_set: frozenset[str] | None
    parsers: list[dict]


CONV_RE = re.compile(
    r"^(?P<type>[a-zA-Z0-9_-]+)(?:\((?P<scopes>[a-zA-Z0-9._-]+(?:,[a-zA-Z0-9._-]+)*)\))?!?: .+"
)


def fail_hook(reason: str, raw_text: str, first_line: str, msg_path: Path) -> None:
    # Prefer per-user $XDG_RUNTIME_DIR; never fall back to world-writable /tmp
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR")
    if xdg_runtime and Path(xdg_runtime).is_dir():
        backup_dir = Path(xdg_runtime)
    else:
        backup_dir = msg_path.resolve().parent

    digest = hashlib.sha256(raw_text.encode("utf-8")).hexdigest()
    backup_path = backup_dir / digest

    # Create with 0600 (O_CREAT | O_EXCL) in the target directory, write, fsync, then atomically rename
    tmp_name = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=backup_dir,
            prefix=f".{digest}.",
            suffix=".tmp",
            delete=False,
        ) as tmp_file:
            tmp_name = tmp_file.name
            tmp_file.write(raw_text)
            tmp_file.flush()
            os.fsync(tmp_file.fileno())

        os.replace(tmp_name, backup_path)
    except BaseException:
        if tmp_name is not None:
            try:
                os.unlink(tmp_name)
            except OSError:
                pass
        raise

    sys.stderr.write(
        f"ERROR: {reason}\n"
        f"Got: {first_line}\n"
        f"Saved commit message to: {backup_path}\n"
        f"Retry with:\n  git commit -eF {backup_path}\n"
    )
    sys.exit(1)


def load_toml(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        with path.open("rb") as f:
            return tomllib.load(f)
    except tomllib.TOMLDecodeError as exc:
        raise ConfigError(f"Invalid TOML in {path}: {exc}") from exc


def load_validator_config() -> ValidatorConfig:
    # Parse pyproject.toml / cliff.toml with stdlib tomllib for scope and commit_parsers validation
    pyproject_cfg = load_toml(Path("pyproject.toml"))
    cliff_cfg = load_toml(Path("cliff.toml"))

    tool_cfg = pyproject_cfg.get("tool", {})
    hook_cfg = tool_cfg.get("commit-msg") if isinstance(tool_cfg, dict) else None
    if hook_cfg is None:
        hook_cfg = cliff_cfg.get("commit-msg", {})
    if not isinstance(hook_cfg, dict):
        raise ConfigError("Commit-msg configuration section must be a TOML table.")

    require_scope = hook_cfg.get("require_scope", False)
    if not isinstance(require_scope, bool):
        raise ConfigError("'require_scope' in commit-msg configuration must be a boolean.")

    allowed_scopes = hook_cfg.get("allowed_scopes")
    allowed_scopes_set: frozenset[str] | None = None
    if allowed_scopes is not None:
        if (
            not isinstance(allowed_scopes, list)
            or not allowed_scopes
            or not all(isinstance(s, str) and s for s in allowed_scopes)
        ):
            raise ConfigError(
                "'allowed_scopes' in commit-msg configuration must be a non-empty list of non-empty strings."
            )
        allowed_scopes_set = frozenset(allowed_scopes)

    git_cfg = cliff_cfg.get("git")
    if git_cfg is None and isinstance(tool_cfg, dict):
        git_cliff_cfg = tool_cfg.get("git-cliff", {})
        if isinstance(git_cliff_cfg, dict):
            git_cfg = git_cliff_cfg.get("git", {})

    parsers: list[dict] = []
    if isinstance(git_cfg, dict):
        raw_parsers = git_cfg.get("commit_parsers", [])
        if not isinstance(raw_parsers, list) or not all(isinstance(p, dict) for p in raw_parsers):
            raise ConfigError("'git.commit_parsers' must be a list of tables.")
        parsers = raw_parsers

    return ValidatorConfig(
        require_scope=require_scope,
        allowed_scopes=allowed_scopes,
        allowed_scopes_set=allowed_scopes_set,
        parsers=parsers,
    )


def validate_subject(first_line: str, cfg: ValidatorConfig) -> str | None:
    # Allow Git auto-generated merge/revert subjects
    if re.match(r"^(Merge|Revert) ", first_line):
        return None

    # Must follow Conventional Commits syntax: <type>(<scope>[,<scope>...])!: <description>
    conv_match = CONV_RE.match(first_line)
    if not conv_match:
        return "Commit summary must follow Conventional Commits: <type>(<scope>[,<scope>...]): <description>"

    scopes_raw = conv_match.group("scopes")
    commit_scopes = scopes_raw.split(",") if scopes_raw else []

    seen_scopes: set[str] = set()
    duplicate_scopes: list[str] = []
    for scope in commit_scopes:
        if scope in seen_scopes and scope not in duplicate_scopes:
            duplicate_scopes.append(scope)
        seen_scopes.add(scope)
    if duplicate_scopes:
        return f"Duplicate commit scope(s): {', '.join(duplicate_scopes)}"

    if cfg.require_scope and not commit_scopes:
        return "Commit summary must include at least one scope: <type>(<scope>): <description>"

    if cfg.allowed_scopes is not None and cfg.allowed_scopes_set is not None:
        unknown_scopes = [s for s in commit_scopes if s not in cfg.allowed_scopes_set]
        if unknown_scopes:
            return (
                f"Disallowed commit scope(s): {', '.join(unknown_scopes)}\n"
                f"Allowed scopes: {', '.join(cfg.allowed_scopes)}"
            )

    if cfg.parsers:
        matched = False
        for parser in cfg.parsers:
            pattern = parser.get("message")
            if not pattern:
                continue
            if re.search(pattern, first_line):
                if parser.get("skip", False):
                    return f"Commit summary matches a skipped rule in cliff.toml ({pattern})."
                matched = True
                break

        if not matched:
            allowed = [
                p["message"].lstrip("^")
                for p in cfg.parsers
                if "message" in p and not p.get("skip")
            ]
            return (
                "Commit type is not accepted by any commit_parsers rule in cliff.toml.\n"
                f"Accepted patterns: {', '.join(allowed)}"
            )

    return None


def check_rev_range(rev_range: str, cfg: ValidatorConfig) -> int:
    if not rev_range or rev_range.startswith("-"):
        sys.stderr.write(f"ERROR: Invalid revision range: {rev_range!r}\n")
        return 1

    proc = subprocess.run(
        ["git", "log", "-z", "--format=%H%n%B", "--end-of-options", rev_range, "--"],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=False,
    )
    if proc.returncode != 0:
        sys.stderr.write(f"ERROR: git log failed for {rev_range!r}:\n{proc.stderr}")
        return 1

    entries = [entry for entry in proc.stdout.split("\0") if entry]
    failures = 0
    for entry in entries:
        commit_sha, _, raw_body = entry.partition("\n")
        first_line = raw_body.splitlines()[0] if raw_body.strip() else ""
        err = validate_subject(first_line, cfg)
        if err is not None:
            failures += 1
            sys.stderr.write(
                f"ERROR ({commit_sha[:12]}): {err}\n"
                f"  Got: {first_line}\n"
            )

    if failures:
        sys.stderr.write(
            f"Commit validation failed: {failures} of {len(entries)} commit(s) invalid.\n"
        )
        return 1

    sys.stdout.write(f"Validated {len(entries)} commit(s) in {rev_range}.\n")
    return 0


def main() -> int:
    arg_parser = argparse.ArgumentParser(
        description="Validate commit messages via Git commit-msg hook or CI revision range."
    )
    arg_parser.add_argument(
        "--rev-range",
        metavar="RANGE",
        help="Git revision specifier or range to validate (e.g. origin/main..HEAD).",
    )
    arg_parser.add_argument(
        "msg_file",
        nargs="?",
        help="Path to the commit message file passed by Git to commit-msg.",
    )
    args = arg_parser.parse_args()

    if (args.rev_range is None) == (args.msg_file is None):
        arg_parser.error("Provide either MSG_FILE (hook mode) or --rev-range RANGE (CI mode).")

    if args.rev_range is not None:
        try:
            cfg = load_validator_config()
        except ConfigError as exc:
            sys.stderr.write(f"ERROR: {exc}\n")
            return 1
        return check_rev_range(args.rev_range, cfg)

    msg_path = Path(args.msg_file)
    raw_text = msg_path.read_text(encoding="utf-8") if msg_path.exists() else ""
    first_line = raw_text.splitlines()[0] if raw_body_present(raw_text) else ""

    try:
        cfg = load_validator_config()
    except ConfigError as exc:
        fail_hook(str(exc), raw_text, first_line, msg_path)

    err = validate_subject(first_line, cfg)
    if err is not None:
        fail_hook(err, raw_text, first_line, msg_path)

    return 0


def raw_body_present(text: str) -> bool:
    return bool(text.strip())


if __name__ == "__main__":
    sys.exit(main())
